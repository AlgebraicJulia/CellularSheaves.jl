<?xml version="1.0"?>
<model>
  <name>apark_bebop</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>CellularSheaves.jl</name><email>adamkadosh@gmail.com</email></author>
  <description>
    Parrot Bebop 2. The body is Parrot's shape as modelled in BebopS, scaled up
    to the x500's rotor arm span so the rotors sit at the ends of the arms.
    The Bebop is not a PX4 airframe: it flies here on x500 masses, inertias,
    rotor geometry and motor constants, and would need its own airframe and
    adapter before any of this transfers to the hardware.
  </description>
</model>
