<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="apark_go1">

    <!-- base_link rides at 0.3403 m: with the thighs at 0.72 rad and the calves at
         -1.44 the feet land exactly on z=0, so the standing pose neither sinks
         nor floats. That is the gait node's neutral stance, and it is what the
         twelve joint controllers below hold when the robot is not moving.

         The legs are real kinematics now: hip, thigh and calf are separate links
         on revolute joints, with the origins, axes and limits taken from
         go1_description's xacro. They carry no collision geometry on purpose. The
         body's weight rides on the hidden wheels further down, and a swinging
         leg that could touch the ground would fight that drive; leaving the legs
         out of the contact set keeps the gait purely a matter of what the camera
         sees.

         The leg masses are deliberately tiny, and subtracted from the trunk so
         the model's total, and therefore how the wheels accelerate it, is what
         it was before the legs existed. A leg heavy enough to matter also
         matters on the first simulation step, where it swings up from the pose
         written here into the standing pose and shoves the body several
         centimetres sideways before anything has been commanded. -->
    <link name="base_link">
      <pose>0 0 0.3403 0 0 0</pose>
      <inertial>
        <mass>11.82</mass>
        <inertia>
          <ixx>0.1040</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.4481</iyy><iyz>0</iyz>
          <izz>0.5009</izz>
        </inertia>
      </inertial>
      <!-- One box over the standing envelope. It clears the drive wheels below,
           so the only thing that touches the ground is the wheel/caster set. -->
      <collision name="collision">
        <geometry><box><size>0.65 0.28 0.16</size></box></geometry>
      </collision>
      <visual name="trunk">
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/trunk.dae</uri></mesh></geometry>
      </visual>
      <visual name="mocap_shell">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.12 0.12 0.04</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.12 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
      </sensor>
    </link>

    <!-- One leg chain per corner, in the unitree link order trunk -> hip ->
         thigh -> calf, with the foot as a visual on the calf rather than a link
         of its own. Joint zero is the xacro's zero, which is the leg hanging
         straight down and not the standing pose, so every angle here means on
         this model what it means on the real machine. -->
    <link name="FR_hip">
      <pose relative_to="base_link">0.1881 -0.04675 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia><ixx>1.270e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.270e-05</iyy><iyz>0</iyz><izz>1.270e-05</izz></inertia>
      </inertial>
      <visual name="FR_hip">
        <pose>0 0 0 3.141593 0 0</pose>
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/hip.dae</uri></mesh></geometry>
      </visual>
    </link>
    <link name="FR_thigh">
      <pose relative_to="FR_hip">0 -0.08 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.1065 0 0 0</pose>
        <mass>0.02</mass>
        <inertia><ixx>7.562e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.562e-05</iyy><iyz>0</iyz><izz>1.512e-06</izz></inertia>
      </inertial>
      <visual name="FR_thigh">
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/thigh_mirror.dae</uri></mesh></geometry>
      </visual>
    </link>
    <link name="FR_calf">
      <pose relative_to="FR_thigh">0 0 -0.213 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.1065 0 0 0</pose>
        <mass>0.01</mass>
        <inertia><ixx>3.781e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.781e-05</iyy><iyz>0</iyz><izz>7.562e-07</izz></inertia>
      </inertial>
      <visual name="FR_calf">
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/calf.dae</uri></mesh></geometry>
      </visual>
      <visual name="FR_foot">
        <pose>0 0 -0.213 0 0 0</pose>
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="FL_hip">
      <pose relative_to="base_link">0.1881 0.04675 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia><ixx>1.270e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.270e-05</iyy><iyz>0</iyz><izz>1.270e-05</izz></inertia>
      </inertial>
      <visual name="FL_hip">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/hip.dae</uri></mesh></geometry>
      </visual>
    </link>
    <link name="FL_thigh">
      <pose relative_to="FL_hip">0 0.08 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.1065 0 0 0</pose>
        <mass>0.02</mass>
        <inertia><ixx>7.562e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.562e-05</iyy><iyz>0</iyz><izz>1.512e-06</izz></inertia>
      </inertial>
      <visual name="FL_thigh">
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/thigh.dae</uri></mesh></geometry>
      </visual>
    </link>
    <link name="FL_calf">
      <pose relative_to="FL_thigh">0 0 -0.213 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.1065 0 0 0</pose>
        <mass>0.01</mass>
        <inertia><ixx>3.781e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.781e-05</iyy><iyz>0</iyz><izz>7.562e-07</izz></inertia>
      </inertial>
      <visual name="FL_calf">
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/calf.dae</uri></mesh></geometry>
      </visual>
      <visual name="FL_foot">
        <pose>0 0 -0.213 0 0 0</pose>
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="RR_hip">
      <pose relative_to="base_link">-0.1881 -0.04675 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia><ixx>1.270e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.270e-05</iyy><iyz>0</iyz><izz>1.270e-05</izz></inertia>
      </inertial>
      <visual name="RR_hip">
        <pose>0 0 0 3.141593 3.141593 0</pose>
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/hip.dae</uri></mesh></geometry>
      </visual>
    </link>
    <link name="RR_thigh">
      <pose relative_to="RR_hip">0 -0.08 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.1065 0 0 0</pose>
        <mass>0.02</mass>
        <inertia><ixx>7.562e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.562e-05</iyy><iyz>0</iyz><izz>1.512e-06</izz></inertia>
      </inertial>
      <visual name="RR_thigh">
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/thigh_mirror.dae</uri></mesh></geometry>
      </visual>
    </link>
    <link name="RR_calf">
      <pose relative_to="RR_thigh">0 0 -0.213 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.1065 0 0 0</pose>
        <mass>0.01</mass>
        <inertia><ixx>3.781e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.781e-05</iyy><iyz>0</iyz><izz>7.562e-07</izz></inertia>
      </inertial>
      <visual name="RR_calf">
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/calf.dae</uri></mesh></geometry>
      </visual>
      <visual name="RR_foot">
        <pose>0 0 -0.213 0 0 0</pose>
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="RL_hip">
      <pose relative_to="base_link">-0.1881 0.04675 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia><ixx>1.270e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.270e-05</iyy><iyz>0</iyz><izz>1.270e-05</izz></inertia>
      </inertial>
      <visual name="RL_hip">
        <pose>0 0 0 0 3.141593 0</pose>
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/hip.dae</uri></mesh></geometry>
      </visual>
    </link>
    <link name="RL_thigh">
      <pose relative_to="RL_hip">0 0.08 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.1065 0 0 0</pose>
        <mass>0.02</mass>
        <inertia><ixx>7.562e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.562e-05</iyy><iyz>0</iyz><izz>1.512e-06</izz></inertia>
      </inertial>
      <visual name="RL_thigh">
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/thigh.dae</uri></mesh></geometry>
