    </link>
    <link name="RL_calf">
      <pose relative_to="RL_thigh">0 0 -0.213 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.1065 0 0 0</pose>
        <mass>0.01</mass>
        <inertia><ixx>3.781e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.781e-05</iyy><iyz>0</iyz><izz>7.562e-07</izz></inertia>
      </inertial>
      <visual name="RL_calf">
        <geometry><mesh><uri>file:///opt/unitree_ros/robots/go1_description/meshes/calf.dae</uri></mesh></geometry>
      </visual>
      <visual name="RL_foot">
        <pose>0 0 -0.213 0 0 0</pose>
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="FR_hip_joint" type="revolute">
      <parent>base_link</parent><child>FR_hip</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.863</lower><upper>0.863</upper><effort>23.7</effort><velocity>30.1</velocity></limit>
      </axis>
    </joint>
    <joint name="FR_thigh_joint" type="revolute">
      <parent>FR_hip</parent><child>FR_thigh</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.686</lower><upper>4.501</upper><effort>23.7</effort><velocity>30.1</velocity></limit>
      </axis>
    </joint>
    <joint name="FR_calf_joint" type="revolute">
      <parent>FR_thigh</parent><child>FR_calf</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-2.818</lower><upper>-0.888</upper><effort>35.55</effort><velocity>20.06</velocity></limit>
      </axis>
    </joint>
    <joint name="FL_hip_joint" type="revolute">
      <parent>base_link</parent><child>FL_hip</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.863</lower><upper>0.863</upper><effort>23.7</effort><velocity>30.1</velocity></limit>
      </axis>
    </joint>
    <joint name="FL_thigh_joint" type="revolute">
      <parent>FL_hip</parent><child>FL_thigh</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.686</lower><upper>4.501</upper><effort>23.7</effort><velocity>30.1</velocity></limit>
      </axis>
    </joint>
    <joint name="FL_calf_joint" type="revolute">
      <parent>FL_thigh</parent><child>FL_calf</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-2.818</lower><upper>-0.888</upper><effort>35.55</effort><velocity>20.06</velocity></limit>
      </axis>
    </joint>
    <joint name="RR_hip_joint" type="revolute">
      <parent>base_link</parent><child>RR_hip</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.863</lower><upper>0.863</upper><effort>23.7</effort><velocity>30.1</velocity></limit>
      </axis>
    </joint>
    <joint name="RR_thigh_joint" type="revolute">
      <parent>RR_hip</parent><child>RR_thigh</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.686</lower><upper>4.501</upper><effort>23.7</effort><velocity>30.1</velocity></limit>
      </axis>
    </joint>
    <joint name="RR_calf_joint" type="revolute">
      <parent>RR_thigh</parent><child>RR_calf</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-2.818</lower><upper>-0.888</upper><effort>35.55</effort><velocity>20.06</velocity></limit>
      </axis>
    </joint>
    <joint name="RL_hip_joint" type="revolute">
      <parent>base_link</parent><child>RL_hip</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.863</lower><upper>0.863</upper><effort>23.7</effort><velocity>30.1</velocity></limit>
      </axis>
    </joint>
    <joint name="RL_thigh_joint" type="revolute">
      <parent>RL_hip</parent><child>RL_thigh</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.686</lower><upper>4.501</upper><effort>23.7</effort><velocity>30.1</velocity></limit>
      </axis>
    </joint>
    <joint name="RL_calf_joint" type="revolute">
      <parent>RL_thigh</parent><child>RL_calf</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-2.818</lower><upper>-0.888</upper><effort>35.55</effort><velocity>20.06</velocity></limit>
      </axis>
    </joint>

    <!-- The quadruped is driven as a unicycle: the sheaf demo only ever commands
         a body twist, and a real legged controller is not what it is about. These
         four contact bodies carry no visual, so what the camera sees is the legged
         machine while the same DiffDrive plugin the Jackal uses moves it and
         publishes odometry. The legs above follow that motion rather than cause
         it, which is why they are kept out of the contact set. -->
    <link name="wheel_left">
      <pose>0 0.1250 0.1000 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia><ixx>0.001083</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.002000</iyy><iyz>0</iyz><izz>0.001083</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.1000</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="wheel_right">
      <pose>0 -0.1250 0.1000 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia><ixx>0.001083</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.002000</iyy><iyz>0</iyz><izz>0.001083</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.1000</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="caster_front">
      <pose>0.2600 0 0.0600 0 0 0</pose>
      <inertial>
        <mass>0.100</mass>
        <inertia><ixx>1.440e-04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.440e-04</iyy><iyz>0</iyz><izz>1.440e-04</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.0600</radius></sphere></geometry>
        <surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="caster_rear">
      <pose>-0.2600 0 0.0600 0 0 0</pose>
      <inertial>
        <mass>0.100</mass>
        <inertia><ixx>1.440e-04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.440e-04</iyy><iyz>0</iyz><izz>1.440e-04</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.0600</radius></sphere></geometry>
        <surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_left</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_right</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="caster_front_joint" type="ball">
      <parent>base_link</parent><child>caster_front</child>
    </joint>
    <joint name="caster_rear_joint" type="ball">
      <parent>base_link</parent><child>caster_rear</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.25</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <!-- One position controller per joint. use_velocity_commands makes each
         one a velocity constraint rather than a torque, which is what a
         load-free decorative leg wants: it tracks the gait node's target
         without drooping under gravity and without a tuned PID. The
         initial_position values are the neutral stance, so the robot spawns
         standing instead of snapping there on the first command. -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>FR_hip_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>FR_thigh_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>0.72</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>FR_calf_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>-1.44</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>FL_hip_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>FL_thigh_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>0.72</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>FL_calf_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>-1.44</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>RR_hip_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>RR_thigh_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>0.72</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>RR_calf_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>-1.44</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>RL_hip_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>RL_thigh_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>0.72</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>RL_calf_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>120</p_gain>
      <initial_position>-1.44</initial_position>
    </plugin>

    <!-- Published so the gait can be checked from outside: the twelve angles on
         /world/<world>/model/<model>/joint_state. Rate-limited on purpose, since
         the default is one message per physics step and nothing needs the leg
         angles at a kilohertz. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <update_rate>100</update_rate>
      <joint_name>FR_hip_joint</joint_name>
      <joint_name>FR_thigh_joint</joint_name>
      <joint_name>FR_calf_joint</joint_name>
      <joint_name>FL_hip_joint</joint_name>
      <joint_name>FL_thigh_joint</joint_name>
      <joint_name>FL_calf_joint</joint_name>
      <joint_name>RR_hip_joint</joint_name>
      <joint_name>RR_thigh_joint</joint_name>
      <joint_name>RR_calf_joint</joint_name>
      <joint_name>RL_hip_joint</joint_name>
      <joint_name>RL_thigh_joint</joint_name>
      <joint_name>RL_calf_joint</joint_name>
    </plugin>

  </model>
</sdf>
