<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="apark_jackal">

    <!-- Numbers below are the J100's own, out of clearpath_platform_description's
         j100.urdf.xacro: wheels sit 0.0345 above chassis_link and have a 0.098
         radius, so the chassis rides 0.0635 above the ground. j100_base.stl is
         authored lying on its side, hence the (pi/2, 0, pi/2) visual rotation and
         the -0.0655 lift the xacro applies; with both, the mesh spans exactly
         0 to 0.184 above chassis_link, which is the chassis height the collision
         box uses. Getting that offset wrong is what makes the body float. -->
    <link name="base_link">
      <pose>0 0 0.0635 0 0 0</pose>
      <inertial>
        <mass>16.523</mass>
        <pose>0.012 0.002 0.067 0 0 0</pose>
        <inertia>
          <ixx>0.3136</ixx><ixy>-0.0008</ixy><ixz>0.0164</ixz>
          <iyy>0.3922</iyy><iyz>-0.0009</iyz>
          <izz>0.4485</izz>
        </inertia>
      </inertial>
      <!-- One box, the same simplification the J100 URDF makes: the fenders and
           the recessed top tray are in the visual mesh only, so collision cost
           does not scale with the mesh's triangle count. -->
      <collision name="collision">
        <pose>0 0 0.092 0 0 0</pose>
        <geometry><box><size>0.420 0.310 0.184</size></box></geometry>
      </collision>
      <visual name="base_link_visual">
        <pose>0 0 -0.0655 1.5707963 0 1.5707963</pose>
        <geometry>
          <mesh><uri>file:///opt/ros/humble/share/clearpath_platform_description/meshes/j100/j100_base.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <!-- The fenders are a separate mesh in the URDF and carry the yellow that
           makes a Jackal recognisable, so leaving them off would give a grey
           slab with bare wheels. Clearpath's generator places them off the same
           attachment point, one unrotated and one turned through pi: the mesh
           runs 0 to 0.2553 forward and +-0.215 across, so the pair is what gives
           the machine its real 0.51 x 0.43 footprint. They arch over the wheels
           and are visual only, exactly as in the URDF. -->
      <visual name="front_fender_visual">
        <geometry>
          <mesh><uri>file:///opt/ros/humble/share/clearpath_platform_description/meshes/j100/attachments/default_fender.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.0 1</ambient>
          <diffuse>0.80 0.80 0.0 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="rear_fender_visual">
        <pose>0 0 0 0 0 3.1415927</pose>
        <geometry>
          <mesh><uri>file:///opt/ros/humble/share/clearpath_platform_description/meshes/j100/attachments/default_fender.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.0 1</ambient>
          <diffuse>0.80 0.80 0.0 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="mocap_shell">
        <pose>0 0 0.214 0 0 0</pose>
        <geometry><box><size>0.20 0.20 0.06</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.12 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
      </sensor>
    </link>

    <!-- A real Jackal is a four-wheel skid steer with no castor anywhere: all
         four wheels are fixed and driven, and the machine yaws by scrubbing the
         tyres sideways. Wheel centres are the xacro's wheelbase/2 = 0.131 and
         track/2 = 0.187795, at exactly the wheel radius above the ground.
         Both wheels on a side are handed to the one DiffDrive plugin, which
         accepts repeated left_joint/right_joint elements, so the interface the
         bridge sees is unchanged. mu2 is deliberately far below mu: with matched
         friction the lateral scrub a skid steer needs never happens and the
         robot barely yaws. fdir1 has to come with it, as it does in the J100
         URDF, because it is what pins mu to the rolling direction and mu2 to the
         sideways one; without it the solver picks the friction axes itself and
         lowering mu2 changes nothing. Measured on a mu=1 ground plane, the pair
         is worth 0.36 rad/s of a commanded 0.4, against 0.21 for mu2 alone. -->
    <link name="wheel_front_left">
      <pose>0.131 0.187795 0.098 0 0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia><ixx>0.0013</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0024</iyy><iyz>0</iyz><izz>0.0013</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.3</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <mesh><uri>file:///opt/ros/humble/share/clearpath_platform_description/meshes/j100/j100_wheel.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wheel_front_right">
      <pose>0.131 -0.187795 0.098 0 0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia><ixx>0.0013</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0024</iyy><iyz>0</iyz><izz>0.0013</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.3</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <mesh><uri>file:///opt/ros/humble/share/clearpath_platform_description/meshes/j100/j100_wheel.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wheel_rear_left">
      <pose>-0.131 0.187795 0.098 0 0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia><ixx>0.0013</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0024</iyy><iyz>0</iyz><izz>0.0013</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.3</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <mesh><uri>file:///opt/ros/humble/share/clearpath_platform_description/meshes/j100/j100_wheel.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wheel_rear_right">
      <pose>-0.131 -0.187795 0.098 0 0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia><ixx>0.0013</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0024</iyy><iyz>0</iyz><izz>0.0013</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.3</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <mesh><uri>file:///opt/ros/humble/share/clearpath_platform_description/meshes/j100/j100_wheel.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wheel_front_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_front_left</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="wheel_front_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_front_right</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="wheel_rear_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_rear_left</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="wheel_rear_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_rear_right</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_front_left_joint</left_joint>
      <left_joint>wheel_rear_left_joint</left_joint>
      <right_joint>wheel_front_right_joint</right_joint>
      <right_joint>wheel_rear_right_joint</right_joint>
      <wheel_separation>0.37559</wheel_separation>
      <wheel_radius>0.098</wheel_radius>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

  </model>
</sdf>
