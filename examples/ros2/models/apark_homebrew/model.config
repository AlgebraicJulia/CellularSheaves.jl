<?xml version="1.0"?>
<model>
  <name>apark_homebrew</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>CellularSheaves.jl</name><email>adamkadosh@gmail.com</email></author>
  <description>
    The park's home-built PX4 quad. The body is the 3DR Iris from
    rotors_description, an open mesh of exactly the hobby-grade airframe a
    home build is made from. Masses, inertias, rotor geometry and motor
    constants are x500's, unchanged, because PX4 flies this agent on airframe
    4001.
  </description>
</model>
