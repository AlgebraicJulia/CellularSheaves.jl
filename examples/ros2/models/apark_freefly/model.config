<?xml version="1.0"?>
<model>
  <name>apark_freefly</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>CellularSheaves.jl</name><email>adamkadosh@gmail.com</email></author>
  <description>
    Heavy-lift park quad on PX4's x500 flight model. No Freefly airframe is
    published as a free mesh anywhere we could find, so the body is the AscTec
    NEO 11 from rotors_description, which is the closest open model of a
    professional heavy-lift platform. It is a stand-in for the look, not the
    machine: masses, inertias, rotor geometry and motor constants are x500's,
    unchanged, because PX4 flies this agent on airframe 4001.
  </description>
</model>
